      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "sideEffects": [
    "**/*.svelte"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@tiptap/core": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "yaml": "^1.10.3"
