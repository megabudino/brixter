{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "noEmitOnError": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["svelte"]
  },
  "include": [
    "./index.ts",
    "./markup/**/*.ts",
    "./svelte/**/*.ts",
    "./editor/**/*.ts",
    "./preview/**/*.ts",
    "./core.ts",
    "./editor-controller.ts",
    "./preview-dom.ts",
    "./svelte.d.ts"
  ],
  "exclude": [
    "./dist",
    "./node_modules",
    "./scripts",
    "./core.spec.ts",
    "./**/*.spec.ts"
  ]
}
