PUBLIC_DEBUG=false

# Path to the SQLite database file (relative to project root or absolute).
DATABASE_URL=data/db.sqlite3

# Public origin of the deployment (used as baseURL for BetterAuth).
ORIGIN=""

# Auth secret (BetterAuth under the hood).
# In production use 32 characters with high entropy.
BRIXTER_AUTH_SECRET=""

# GitHub App credentials
GITHUB_APP_ID=""
GITHUB_PRIVATE_KEY=""
GITHUB_INSTALLATION_ID=""

# Optional GitHub repository override.
# By default brixter infers this from the Git remote during the Vite build.
GITHUB_REPO_OWNER=""
GITHUB_REPO_NAME=""
GITHUB_DEFAULT_BRANCH=""

# Optional build metadata fallback for CI/Docker builds without a .git directory.
BRIXTER_SOURCE_REPO=""
BRIXTER_SOURCE_DEFAULT_BRANCH=""
BRIXTER_SOURCE_COMMIT=""

# Optional SvelteKit app location inside the repo. Normally inferred from Vite root.
BRIXTER_APP_ROOT=""
BRIXTER_ROUTES_ROOT=""
