{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": "./src",
		"outDir": "./dist",
		"rewriteRelativeImportExtensions": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"noEmitOnError": true,
		"strict": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true
	},
	// Everything that runs in Node during a build — the Vite plugin, and the
	// adapter wrapper loaded from `svelte.config.js` — has to ship as compiled
	// JS. The rest of the package is consumed through the app's own bundler and
	// ships as source.
	"include": ["./src/vite/**/*.ts", "./src/sveltekit/redirects/**/*.ts"]
}
