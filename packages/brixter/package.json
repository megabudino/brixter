{
	"name": "brixter",
	"version": "0.0.24",
	"description": "SvelteKit CMS with dashboard, visual builder, and .brix.yaml pages",
	"license": "MIT",
	"author": "megabudino (https://github.com/megabudino)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/megabudino/brixter.git",
		"directory": "packages/brixter"
	},
	"bugs": {
		"url": "https://github.com/megabudino/brixter/issues"
	},
	"homepage": "https://github.com/megabudino/brixter/tree/main/packages/brixter#readme",
	"keywords": [
		"brixter",
		"cms",
		"sveltekit",
		"svelte",
		"content-management"
	],
	"type": "module",
	"packageManager": "bun@1.2.15",
	"svelte": "./src/lib/index.ts",
	"files": [
		"LICENSE",
		"README.md",
		"bin",
		"dist",
		"src/lib",
		"static",
		"styles.css"
	],
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts",
			"default": "./src/lib/index.ts"
		},
		"./server": {
			"types": "./src/lib/server/index.ts",
			"default": "./src/lib/server/index.ts"
		},
		"./editor": {
			"types": "./src/lib/editor/index.ts",
			"svelte": "./src/lib/editor/index.ts",
			"default": "./src/lib/editor/index.ts"
		},
		"./ui": {
			"types": "./src/lib/ui/index.ts",
			"svelte": "./src/lib/ui/index.ts",
			"default": "./src/lib/ui/index.ts"
		},
		"./sveltekit": {
			"types": "./src/lib/sveltekit/index.d.ts",
			"svelte": "./src/lib/sveltekit/component.ts",
			"default": "./src/lib/sveltekit/component.ts"
		},
		"./sveltekit/reroute": {
			"types": "./src/lib/sveltekit/reroute.ts",
			"default": "./src/lib/sveltekit/reroute.ts"
		},
		"./sveltekit/server": {
			"types": "./src/lib/sveltekit/server.ts",
			"default": "./src/lib/sveltekit/server.ts"
		},
		"./sveltekit/api": {
			"types": "./src/lib/sveltekit/api.ts",
			"default": "./src/lib/sveltekit/api.ts"
		},
		"./vite": {
			"types": "./dist/vite/index.d.ts",
			"default": "./dist/vite/index.js"
		},
		"./styles.css": "./styles.css"
	},
	"scripts": {
		"build:package": "node ./scripts/build-package.mjs",
		"prepublishOnly": "npm run build:package",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"auth:schema": "bunx @better-auth/cli@1.5.0-beta.13 generate --config src/lib/server/auth-cli.ts --output src/lib/server/db/auth.schema.ts --yes",
		"db:migrate": "bun scripts/migrate.ts"
	},
	"bin": {
		"brixter": "./bin/brixter.js"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-node": "^5.5.2",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22",
		"@types/turndown": "^5.0.6",
		"@vitest/browser-playwright": "^4.1.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"mdsvex": "^0.12.6",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.20.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"vitest": "^4.1.0",
		"vitest-browser-svelte": "^2.0.2"
	},
	"trustedDependencies": [
		"better-sqlite3"
	],
	"dependencies": {
		"@brixter/brix-builder": "^0.0.5",
		"@octokit/auth-app": "^8.2.0",
		"@octokit/core": "^7.0.6",
		"@tailwindcss/typography": "^0.5.19",
		"@tiptap/core": "^3.20.1",
		"@tiptap/extension-blockquote": "^3.20.1",
		"@tiptap/extension-code-block": "^3.20.1",
		"@tiptap/extension-color": "^3.20.1",
		"@tiptap/extension-highlight": "^3.20.1",
		"@tiptap/extension-horizontal-rule": "^3.20.1",
		"@tiptap/extension-image": "^3.20.1",
		"@tiptap/extension-link": "^3.20.1",
		"@tiptap/extension-subscript": "^3.20.1",
		"@tiptap/extension-superscript": "^3.20.1",
		"@tiptap/extension-table": "^3.20.1",
		"@tiptap/extension-table-cell": "^3.20.1",
		"@tiptap/extension-table-header": "^3.20.1",
		"@tiptap/extension-table-row": "^3.20.1",
		"@tiptap/extension-task-item": "^3.20.1",
		"@tiptap/extension-task-list": "^3.20.1",
		"@tiptap/extension-text-align": "^3.20.1",
		"@tiptap/extension-text-style": "^3.20.1",
		"@tiptap/extension-underline": "^3.20.1",
		"@tiptap/extensions": "^3.20.1",
		"@tiptap/starter-kit": "^3.20.1",
		"better-auth": "1.6.11",
		"better-sqlite3": "^12.6.2",
		"lucide-static": "^0.477.0",
		"lucide-svelte": "^1.0.1",
		"marked": "^17.0.4",
		"monaco-editor": "^0.55.1",
		"turndown": "^7.2.2",
		"yaml": "^1.10.3"
	}
}
