{
	"name": "brixter",
	"version": "0.2.2",
	"description": "SvelteKit CMS with dashboard, visual builder, and .brix.yaml pages",
	"license": "MIT",
	"author": "megabudino (https://github.com/megabudino)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/megabudino/brixter.git",
		"directory": "packages/brixter"
	},
	"bugs": {
		"url": "https://github.com/megabudino/brixter/issues"
	},
	"homepage": "https://github.com/megabudino/brixter/tree/main/packages/brixter#readme",
	"keywords": [
		"brixter",
		"cms",
		"sveltekit",
		"svelte",
		"content-management"
	],
	"type": "module",
	"packageManager": "bun@1.2.15",
	"svelte": "./src/index.ts",
	"files": [
		"LICENSE",
		"README.md",
		"bin",
		"dist",
		"src",
		"styles.css"
	],
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"default": "./dist/server/index.js"
		},
		"./server/migrate": {
			"types": "./dist/server/migrate.d.ts",
			"default": "./dist/server/migrate.js"
		},
		"./server/auth-migrate": {
			"types": "./dist/server/auth-migrate.d.ts",
			"default": "./dist/server/auth-migrate.js"
		},
		"./editor": {
			"types": "./src/editor/index.ts",
			"svelte": "./src/editor/index.ts",
			"default": "./src/editor/index.ts"
		},
		"./ui": {
			"types": "./src/ui/index.ts",
			"svelte": "./src/ui/index.ts",
			"default": "./src/ui/index.ts"
		},
		"./seo": {
			"types": "./src/seo/BrixSeo.svelte",
			"svelte": "./src/seo/BrixSeo.svelte",
			"default": "./src/seo/BrixSeo.svelte"
		},
		"./sveltekit": {
			"types": "./src/sveltekit/index.d.ts",
			"svelte": "./src/sveltekit/component.ts",
			"default": "./src/sveltekit/component.ts"
		},
		"./sveltekit/reroute": {
			"types": "./src/sveltekit/reroute.ts",
			"default": "./src/sveltekit/reroute.ts"
		},
		"./sveltekit/server": {
			"types": "./src/sveltekit/server.ts",
			"default": "./src/sveltekit/server.ts"
		},
		"./sveltekit/api": {
			"types": "./src/sveltekit/api.ts",
			"default": "./src/sveltekit/api.ts"
		},
		"./vite": {
			"types": "./dist/vite/index.d.ts",
			"default": "./dist/vite/index.js"
		},
		"./styles.css": "./styles.css"
	},
	"scripts": {
		"build:package": "node ./scripts/build-package.mjs",
		"prepublishOnly": "npm run build:package",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"auth:schema": "bunx @better-auth/cli@1.5.0-beta.13 generate --config src/server/auth-cli.ts --output src/server/db/auth.schema.ts --yes",
		"db:migrate": "bun scripts/migrate.ts"
	},
	"bin": {
		"brixter": "./bin/brixter.js"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@playwright/test": "^1.58.2",
		"@sveltejs/kit": "^2.50.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.51.0",
		"tsx": "^4.20.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"vitest": "^4.1.0"
	},
	"dependencies": {
		"@brixter/brix-builder": "^0.2.1",
		"@octokit/auth-app": "^8.2.0",
		"@octokit/core": "^7.0.6",
		"@tailwindcss/typography": "^0.5.19",
		"better-auth": "1.6.11",
		"better-sqlite3": "^12.6.2",
		"lucide-static": "^0.477.0",
		"lucide-svelte": "^1.0.1",
		"yaml": "^1.10.3"
	}
}
