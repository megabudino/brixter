{
	"name": "brixter",
	"version": "0.2.3",
	"description": "SvelteKit CMS with dashboard, visual builder, and .brix.yaml pages",
	"license": "MIT",
	"author": "megabudino (https://github.com/megabudino)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/megabudino/brixter.git",
		"directory": "packages/brixter"
	},
	"bugs": {
		"url": "https://github.com/megabudino/brixter/issues"
	},
	"homepage": "https://github.com/megabudino/brixter/tree/main/packages/brixter#readme",
	"keywords": [
		"brixter",
		"cms",
		"sveltekit",
		"svelte",
		"content-management"
	],
	"type": "module",
	"packageManager": "bun@1.2.15",
	"svelte": "./src/runtime/index.ts",
	"files": [
		"LICENSE",
		"README.md",
		"bin",
		"dist",
		"src",
		"styles.css"
	],
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"exports": {
		".": {
			"types": "./src/runtime/index.ts",
			"svelte": "./src/runtime/index.ts",
			"default": "./src/runtime/index.ts"
		},
		"./server": {
			"types": "./dist/studio/server/index.d.ts",
			"default": "./dist/studio/server/index.js"
		},
		"./server/migrate": {
			"types": "./dist/studio/server/migrate.d.ts",
			"default": "./dist/studio/server/migrate.js"
		},
		"./server/auth-migrate": {
			"types": "./dist/studio/server/auth-migrate.d.ts",
			"default": "./dist/studio/server/auth-migrate.js"
		},
		"./editor": {
			"types": "./src/studio/editor/index.ts",
			"svelte": "./src/studio/editor/index.ts",
			"default": "./src/studio/editor/index.ts"
		},
		"./ui": {
			"types": "./src/studio/ui/index.ts",
			"svelte": "./src/studio/ui/index.ts",
			"default": "./src/studio/ui/index.ts"
		},
		"./seo": {
			"types": "./src/runtime/seo/BrixSeo.svelte",
			"svelte": "./src/runtime/seo/BrixSeo.svelte",
			"default": "./src/runtime/seo/BrixSeo.svelte"
		},
		"./sveltekit": {
			"types": "./src/studio/sveltekit/index.d.ts",
			"svelte": "./src/studio/sveltekit/component.ts",
			"default": "./src/studio/sveltekit/component.ts"
		},
		"./sveltekit/reroute": {
			"types": "./src/studio/sveltekit/reroute.ts",
			"default": "./src/studio/sveltekit/reroute.ts"
		},
		"./sveltekit/server": {
			"types": "./src/studio/sveltekit/server.ts",
			"default": "./src/studio/sveltekit/server.ts"
		},
		"./sveltekit/api": {
			"types": "./src/studio/sveltekit/api.ts",
			"default": "./src/studio/sveltekit/api.ts"
		},
		"./vite": {
			"types": "./dist/runtime/vite/index.d.ts",
			"default": "./dist/runtime/vite/index.js"
		},
		"./styles.css": "./styles.css"
	},
	"scripts": {
		"build:package": "node ./scripts/build-package.mjs",
		"prepublishOnly": "npm run build:package",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@sveltejs/kit": "^2.50.2",
		"@types/node": "^22",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.51.0",
		"tsx": "^4.20.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"vitest": "^4.1.0"
	},
	"dependencies": {
		"@brixter/core": "^0.1.0",
		"yaml": "^1.10.3"
	}
}
