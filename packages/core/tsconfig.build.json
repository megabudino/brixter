{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "noEmitOnError": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "./index.ts",
    "./builder.ts",
    "./frontmatter.ts",
    "./template/**/*.ts",
    "./schema/**/*.ts",
    "./page/**/*.ts",
    "./sitemap/**/*.ts",
    "./redirects/**/*.ts"
  ],
  "exclude": [
    "./dist",
    "./node_modules",
    "./scripts",
    "./**/*.spec.ts"
  ]
}
