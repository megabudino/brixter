{
	"name": "@brixter/core",
	"version": "0.5.0",
	"description": "Agnostic brix engine: .brix template language, .md page format, schema inference and validation",
	"license": "MIT",
	"author": "megabudino (https://github.com/megabudino)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Brixter-Labs/brixter.git",
		"directory": "packages/core"
	},
	"bugs": {
		"url": "https://github.com/Brixter-Labs/brixter/issues"
	},
	"homepage": "https://github.com/Brixter-Labs/brixter/tree/main/packages/core#readme",
	"keywords": [
		"brixter",
		"cms",
		"render",
		"markup"
	],
	"type": "module",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "node ./scripts/build.mjs",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./template": {
			"types": "./dist/template/index.d.ts",
			"default": "./dist/template/index.js"
		},
		"./schema": {
			"types": "./dist/schema/index.d.ts",
			"default": "./dist/schema/index.js"
		},
		"./page": {
			"types": "./dist/page/index.d.ts",
			"default": "./dist/page/index.js"
		},
		"./sitemap": {
			"types": "./dist/sitemap/index.d.ts",
			"default": "./dist/sitemap/index.js"
		},
		"./redirects": {
			"types": "./dist/redirects/index.d.ts",
			"default": "./dist/redirects/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"dependencies": {
		"yaml": "^2.8.1"
	}
}
