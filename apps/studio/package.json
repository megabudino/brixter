{
  "name": "@brixter/studio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Brixter Studio — the closed-source dashboard app (not published).",
  "scripts": {
    "dev": "BRIXTER_SOURCE=1 NODE_OPTIONS='--import tsx' vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "build:server": "tsc -p tsconfig.build.server.json",
    "auth:schema": "bunx @better-auth/cli@1.5.0-beta.13 generate --config src/server/auth-cli.ts --output src/server/db/auth.schema.ts --yes",
    "db:migrate": "bun scripts/migrate.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/core": "1.6.11",
    "@brixter/brix-builder": "workspace:*",
    "@brixter/core": "workspace:*",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/core": "^7.0.6",
    "better-auth": "1.6.11",
    "better-sqlite3": "^12.6.2",
    "brixter": "workspace:*",
    "lucide-static": "^0.477.0",
    "lucide-svelte": "^1.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "playwright": "^1.58.2",
    "svelte": "^5.54.0",
    "svelte-check": "^4.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "bin": {
    "brixter": "./bin/brixter.js"
  }
}
