# Path to the SQLite auth database (relative to apps/studio or absolute).
DATABASE_URL=data/brixter.db

# Public origin of the Studio deployment (Better Auth baseURL).
ORIGIN="http://localhost:5173"

# Auth secret (Better Auth). Use 32+ chars of high entropy in production.
BRIXTER_AUTH_SECRET="change-me"

# GitHub App credentials (only required outside local mode).
GITHUB_APP_ID=""
GITHUB_PRIVATE_KEY=""
GITHUB_INSTALLATION_ID=""
GITHUB_REPO_OWNER=""
GITHUB_REPO_NAME=""
GITHUB_DEFAULT_BRANCH=""

# Optional build metadata fallback for CI/Docker builds without a .git directory.
BRIXTER_SOURCE_REPO=""
BRIXTER_SOURCE_DEFAULT_BRANCH=""
BRIXTER_SOURCE_COMMIT=""
