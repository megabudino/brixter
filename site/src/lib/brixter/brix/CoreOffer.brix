---
title: Core offer
description: Core offer presentation with key points and CTA.
---
<section class="bg-white px-6 py-20 dark:bg-gray-900">
	<div class="mx-auto grid max-w-5xl gap-10 md:grid-cols-[0.9fr_1.1fr] md:items-start">
		<div>
			<p class="text-muted mb-3 text-[11px] font-semibold tracking-wide uppercase">
				{eyebrow ?? 'Eyebrow'}
			</p>

			<h2 class="font-display text-heading text-3xl md:text-4xl">
				{@richtext headline ?? 'Headline goes here.'}
			</h2>

			<p class="text-secondary mt-5 text-base leading-7">
				{@richtext description ?? 'A supporting description that follows the headline.'}
			</p>

			<a href={cta.href ?? '#'} class="btn-site-primary mt-8">{cta.label ?? 'Get started'}</a>
		</div>

		<div class="border border-gray-300 bg-gray-50 dark:border-gray-700 dark:bg-gray-800">
			{#each features as feature}
				<div class="border-b border-gray-300 p-6 last:border-b-0 dark:border-gray-700">
					<div class="flex items-start gap-3">
						<span class="mt-1 h-5 w-5 shrink-0 text-yellow-500 dark:text-yellow-400">
							{@icon @label('Icon') feature.icon ?? '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"/></svg>'}
						</span>
						<div>
							<h3 class="text-heading text-lg font-semibold">{feature.title ?? 'Feature title'}</h3>
							<p class="text-secondary mt-2 text-sm leading-6">
								{@richtext feature.text ?? 'Feature description goes here.'}
							</p>
						</div>
					</div>
				</div>
			{/each}
		</div>
	</div>
</section>
