---
title: Pain points
description: Section with three reasons or frictions that lead to the solution.
---
<section class="bg-white px-6 py-20 dark:bg-gray-900">
	<div class="mx-auto max-w-5xl">
		<div class="mx-auto max-w-2xl text-center">
			<p class="text-muted mb-3 text-[11px] font-semibold tracking-wide uppercase">
				{eyebrow ?? 'Why it exists'}
			</p>

			<h2 class="font-display text-heading text-3xl md:text-4xl">
				{@richtext headline ?? 'The hard part is not creating pages. It is keeping them alive.'}
			</h2>
		</div>

		<div class="mt-12 grid gap-4 md:grid-cols-3">
			{#each points as point}
				<article class="border border-gray-300 bg-gray-50 p-6 dark:border-gray-700 dark:bg-gray-800">
					<h3 class="text-heading text-lg font-semibold">
						{point.title ?? 'Every change becomes a request'}
					</h3>
					<p class="text-secondary mt-3 text-sm leading-6">
						{@richtext point.text ?? 'Headlines, sections, CTAs: small edits interrupt engineering work and slow the whole team down.'}
					</p>
				</article>
			{/each}
		</div>
	</div>
</section>
