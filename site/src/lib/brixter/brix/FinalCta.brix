---
title: Final CTA
description: Final CTA for the landing page.
---
<section class="bg-gray-50 px-6 py-20 dark:bg-gray-900">
	<div
		class="mx-auto max-w-5xl border border-gray-300 bg-white px-6 py-12 text-center md:px-12 dark:border-gray-700 dark:bg-gray-900"
		data-reveal
	>
		<h2 class="font-display text-heading mx-auto max-w-2xl text-3xl md:text-4xl">
			{@richtext headline ?? 'Ready to get started?'}
		</h2>

		<p class="text-secondary mx-auto mt-5 max-w-xl text-base leading-7">
			{@richtext subtitle ?? 'Start building pages that are editable, versioned, and ready to grow.'}
		</p>

		<div class="mt-8">
			<a href={cta.href ?? '#'} class="btn-site-primary">{cta.label ?? 'Start now'}</a>
			<p class="text-muted mt-4 text-sm">{@richtext cta.note ?? 'No credit card required.'}</p>
		</div>
	</div>
</section>
