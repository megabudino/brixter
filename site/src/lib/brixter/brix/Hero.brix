---
title: Hero
description: Primary hero with promise, subtitle, and CTA.
---
<section class="relative overflow-hidden bg-gray-50 px-6 py-20 dark:bg-gray-900">
	<div class="mx-auto max-w-2xl text-center" data-reveal>
		<p class="text-muted mb-3 text-[11px] font-semibold tracking-wide uppercase">
			{eyebrow ?? 'Eyebrow'}
		</p>

		<h1 class="font-display text-heading text-4xl leading-tight md:text-5xl">
			{@richtext @required headline}
		</h1>

		<p class="text-secondary mt-5 max-w-2xl text-lg leading-7">
			{@richtext subtitle ?? 'Supporting subtitle.'}
		</p>

		<div class="mt-8 flex items-center justify-center gap-4">
			<a href={cta.href ?? '#'} class="btn-site-primary">{cta.label ?? 'Get started'}</a>
			<p class="text-muted text-sm">{@richtext cta.note ?? 'No credit card required.'}</p>
		</div>

		<img src={@image screenshot} alt="" class="mt-12 w-full max-w-3xl" />
	</div>
</section>
