---
title: Footer
description: Minimal footer to close the landing page.
---
<footer class="border-t border-gray-300 bg-white px-6 py-10 dark:border-gray-700 dark:bg-gray-900">
	<div class="mx-auto flex max-w-5xl flex-col gap-6 md:flex-row md:items-center md:justify-between">
		<div>
			<p class="text-heading font-display text-2xl">{brand ?? 'Brand'}</p>
			<p class="text-muted mt-2 text-sm">{claim ?? 'Claim'}</p>
		</div>

		<nav class="flex flex-wrap gap-4 text-sm">
			{#each links as link}
				<a href={link.href ?? '/'} class="text-secondary hover:text-heading transition-colors">
					{link.label ?? 'Link label'}
				</a>
			{/each}
		</nav>
	</div>
</footer>
