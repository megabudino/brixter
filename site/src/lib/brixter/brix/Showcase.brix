---
description: Feature showcase rendered from plain markup, interpreted at runtime.
fields:
  features:
    label: Features
    itemLabel: Feature
    summaryField: title
    item:
      fields:
        icon:
          kind: icon
  cta:
    fields:
      href:
        default: /admin
---
<section class="bg-white px-6 py-20 dark:bg-gray-900">
	<div class="mx-auto max-w-5xl text-center">
		<p
			class="text-muted mb-3 text-[11px] font-semibold tracking-wide uppercase"
			data-brixter-field="eyebrow"
		>
			Showcase
		</p>

		<h2
			class="font-display text-heading text-3xl md:text-4xl"
			data-brixter-field="headline"
			data-brixter-kind="richtext-inline"
		>
			Built from a plain markup file.
		</h2>

		<p
			class="text-secondary mx-auto mt-4 max-w-2xl text-base leading-7"
			data-brixter-field="description"
			data-brixter-kind="richtext-inline"
		>
			This brik has no Svelte component — it is interpreted at runtime.
		</p>

		<div class="mt-12 grid gap-6 sm:grid-cols-3">
			<div
				class="rounded-lg border border-gray-200 bg-gray-50 p-6 text-left dark:border-gray-700 dark:bg-gray-800"
				data-brixter-collection-item="features"
			>
				<span
					class="mb-3 inline-flex h-6 w-6 text-yellow-500 dark:text-yellow-400"
					data-brixter-field="features[].icon"
					data-brixter-kind="icon"
				></span>
				<h3 class="text-heading text-lg font-semibold" data-brixter-field="features[].title">
					Feature title
				</h3>
				<p
					class="text-secondary mt-2 text-sm leading-6"
					data-brixter-field="features[].text"
					data-brixter-kind="richtext-inline"
				>
					Feature description goes here.
				</p>
			</div>
		</div>

		<a
			href="#"
			class="btn-site-primary mt-10 inline-block"
			data-brixter-field="cta.label"
			data-brixter-bind="href:cta.href"
		>
			Get started
		</a>
	</div>
</section>
