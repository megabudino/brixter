---
title: Team
description: Team section or project signature.
---
<section class="bg-white px-6 py-20 dark:bg-gray-900">
	<div class="mx-auto max-w-5xl">
		<div class="grid gap-8 md:grid-cols-[0.8fr_1.2fr] md:items-end">
			<div>
				<p class="text-muted mb-3 text-[11px] font-semibold tracking-wide uppercase">
					{eyebrow ?? 'Team'}
				</p>

				<h2 class="font-display text-heading text-3xl md:text-4xl">
					{@richtext headline ?? 'Built for people who live between product, code, and content.'}
				</h2>
			</div>

			<p class="text-secondary text-base leading-7">
				{@richtext description ?? 'Brixter removes friction from marketing pages without turning your project into an opaque platform.'}
			</p>
		</div>

		<div class="mt-12 grid gap-4 md:grid-cols-3">
			{#each members as member}
				<article class="border border-gray-300 bg-gray-50 p-6 dark:border-gray-700 dark:bg-gray-800">
					<h3 class="text-heading text-lg font-semibold">{member.name ?? 'Developer'}</h3>
					<p class="text-muted mt-1 text-sm">{member.role ?? 'Components and repository'}</p>
					<p class="text-secondary mt-4 text-sm leading-6">
						{@richtext member.bio ?? 'Defines briks, maintains the design system, and reviews changes like regular code.'}
					</p>
				</article>
			{/each}
		</div>
	</div>
</section>
