---
title: Gallery
description: Image gallery grid with captions for testing collection rendering.
---
<section class="bg-white px-6 py-20 dark:bg-gray-900">
	<div class="mx-auto max-w-5xl">
		<div class="text-center">
			<p class="text-muted mb-3 text-[11px] font-semibold tracking-wide uppercase">
				{eyebrow ?? 'Gallery'}
			</p>

			<h2 class="font-display text-heading text-3xl md:text-4xl">
				{@richtext headline ?? 'A beautiful collection of images.'}
			</h2>

			<p class="text-secondary mx-auto mt-4 max-w-2xl text-base leading-7">
				{@richtext description ?? 'Browse through this curated selection of visuals, each with its own title and caption.'}
			</p>
		</div>

		<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{#each images as image}
				<figure class="group overflow-hidden rounded-lg border border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800">
					<div class="aspect-video overflow-hidden bg-gray-100 dark:bg-gray-700">
						<img
							src={@image image.img}
							alt=""
							class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
						/>
					</div>
					<figcaption class="p-4">
						<h3 class="text-heading text-base font-semibold">{image.title ?? 'Image title'}</h3>
						<p class="text-secondary mt-1 text-sm leading-5">
							{@richtext image.caption ?? 'A short caption describing this image.'}
						</p>
					</figcaption>
				</figure>
			{/each}
		</div>
	</div>
</section>
